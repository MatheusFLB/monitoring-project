# =============================================================================
# .env.example — Template de variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# O deploy.sh cria o .env automaticamente de forma interativa.
#
# IMPORTANTE: Nunca commite o .env real no Git (contém senhas).
# =============================================================================

# ── Grafana / Prometheus / Node Exporter ──
GF_SECURITY_ADMIN_PASSWORD=          # Senha do admin do Grafana (obrigatória)
GRAFANA_PORT=3000                    # Porta da interface web do Grafana
PROMETHEUS_PORT=9090                 # Porta da interface web do Prometheus
NODE_EXPORTER_PORT=9100              # Porta do Node Exporter (métricas do host)

# ── Zabbix ──
ZABBIX_DB_NAME=zabbix                # Nome do banco PostgreSQL
ZABBIX_DB_USER=zabbix                # Usuário do banco PostgreSQL
ZABBIX_DB_PASSWORD=                  # Senha do banco (gerada pelo deploy.sh)
ZABBIX_SERVER_PORT=10051             # Porta do Zabbix Server (comunicação com agentes)
ZABBIX_WEB_PORT=8080                 # Porta da interface web do Zabbix
ZABBIX_AGENT_HOSTNAME=monitoring-host  # Hostname deste host no Zabbix
ZBX_CACHESIZE=32M                    # Cache de configuração do Zabbix (32M para hosts < 8GB RAM)
ZBX_STARTPOLLERS=3                   # Threads de polling (aumentar para mais hosts)
ZBX_STARTPINGERS=2                   # Threads de ICMP ping (aumentar para mais hosts)
TZ=America/Sao_Paulo                 # Timezone (usado pelo Zabbix Web e PHP)

# ── Loki ──
LOKI_PORT=3100                       # Porta da API do Loki (push de logs e queries)
